#!/bin/sh
# Produit un seul exécutable, interface comprise.
#   ./build                 système courant
#   ./build windows         Windows amd64
#   ./build darwin arm64    macOS Apple Silicon
#   ./build all             linux, macOS et Windows, amd64 et arm64
# VERSION et IMAGE, si définis, sont gravés dans l'exécutable (la publication
# les donne) ; sinon il se présente comme une version de développement.
set -eu
cd "$(dirname "$0")"

if ! command -v go >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1 || ! command -v unzip >/dev/null 2>&1; then
  echo "Go, npm et unzip sont requis." >&2
  exit 1
fi

if [ ! -d web/node_modules ]; then
  (cd web && npm ci)
fi
(cd web && npm run build)
rm -rf internal/ui/dist
cp -a web/dist internal/ui/dist
# The only file of the folder git keeps, for a go build without the interface.
: > internal/ui/dist/.keep
mkdir -p dist

# The PostgreSQL packed into the executable. An update refuses another major
# version: its data folder would need a migration.
PG_VERSION=16.15.0

build_one() {
  os="$1"
  arch="$2"
  out="$3"
  tagflag=""
  pgflag=""
  if fetch_postgres "$os" "$arch"; then
    tagflag="-tags postgresembed"
    pgflag="-X main.postgres=${PG_VERSION%%.*}"
  elif [ "$os-$arch" != "windows-arm64" ]; then
    echo "PostgreSQL embarqué introuvable pour $os/$arch." >&2
    exit 1
  fi
  # shellcheck disable=SC2086
  CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" go build -trimpath $tagflag -ldflags "-s -w -X main.version=${VERSION:-dev} -X main.image=${IMAGE:-} $pgflag" -o "$out" ./cmd/myinfra
  echo "$out"
}

# fetch_postgres packs the PostgreSQL of a system into the executable. It is
# called inside an if, where set -e does not apply: each step stops by itself,
# otherwise an empty archive would be embedded without a word.
fetch_postgres() {
  art=$(postgres_artifact "$1" "$2") || return 1
  ver=$PG_VERSION
  url="https://repo1.maven.org/maven2/io/zonky/test/postgres/embedded-postgres-binaries-${art}/${ver}/embedded-postgres-binaries-${art}-${ver}.jar"
  tmp=$(mktemp -d)
  curl -fsSL -A "myinfra-build" -o "$tmp/pg.jar" "$url" || die "PostgreSQL ne se télécharge pas : $url"
  # The .jar is a zip: GNU tar cannot read it, unzip reads it everywhere.
  txz=$(unzip -Z1 "$tmp/pg.jar" | grep '\.txz$' | head -n 1)
  [ -n "$txz" ] || die "Pas d'archive PostgreSQL dans $url"
  unzip -p "$tmp/pg.jar" "$txz" > "$tmp/postgres.txz" || die "Archive PostgreSQL illisible."
  mkdir "$tmp/root"
  tar -xJf "$tmp/postgres.txz" -C "$tmp/root" || die "Archive PostgreSQL illisible."
  [ -f "$tmp/root/bin/postgres" ] || [ -f "$tmp/root/bin/postgres.exe" ] || die "PostgreSQL absent de l'archive pour $1/$2."
  tar -czf internal/boot/postgres.tar.gz -C "$tmp/root" . || die "PostgreSQL ne s'empaquette pas."
  rm -rf "$tmp"
}

die() {
  echo "$1" >&2
  exit 1
}

postgres_artifact() {
  case "$1-$2" in
    darwin-arm64) echo darwin-arm64v8 ;;
    darwin-amd64) echo darwin-amd64 ;;
    linux-amd64) echo linux-amd64 ;;
    linux-arm64) echo linux-arm64v8 ;;
    windows-amd64) echo windows-amd64 ;;
    *) return 1 ;;
  esac
}

target="${1:-host}"
arch="${2:-amd64}"
case "$target" in
  host)
    os=$(go env GOOS)
    arch=$(go env GOARCH)
    ext=""
    if [ "$os" = "windows" ]; then
      ext=".exe"
    fi
    build_one "$os" "$arch" "dist/myinfra${ext}"
    ;;
  all)
    build_one linux amd64 dist/myinfra_linux_amd64
    build_one linux arm64 dist/myinfra_linux_arm64
    build_one darwin amd64 dist/myinfra_darwin_amd64
    build_one darwin arm64 dist/myinfra_darwin_arm64
    build_one windows amd64 dist/myinfra_windows_amd64.exe
    build_one windows arm64 dist/myinfra_windows_arm64.exe
    ;;
  linux | darwin | windows)
    ext=""
    if [ "$target" = "windows" ]; then
      ext=".exe"
    fi
    build_one "$target" "$arch" "dist/myinfra_${target}_${arch}${ext}"
    ;;
  *)
    echo "Usage: ./build [all|linux|darwin|windows] [amd64|arm64]" >&2
    exit 1
    ;;
esac
